   "parameters": {
    "content": "SF8 v-next - Approval View Sync (F32). Publishes ranked scored leads into the v-next Sheet COPY keyed by run_id + company_id. Header gate: run_id, company_id, Decision, Note must exist on the copy or zero rows are written and a Gmail draft names the missing header. Decision and Note columns are never written. insufficient_data rows show as Unknown - insufficient data (F31).",
    "color": 5
   }
  },
