  {
   "id": "2f510bb8-bb84-4243-b87f-147f41ed23f8",
   "name": "DB - Ranked Leads",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.6,
   "position": [
    320,
    400
   ],
   "parameters": {
    "operation": "executeQuery",
    "query": "SELECT $3::text AS run_id, c.id::text AS company_id, c.name AS \"Company\", c.category AS \"Category\", c.location AS \"Location\",\n       c.website AS \"Website\", c.rating AS \"Rating\", c.review_count AS \"Reviews\",\n       s.fit_score AS \"Fit\", s.timing_score AS \"Timing\",\n       CASE WHEN s.band = 'insufficient_data' THEN 'Unknown \u2014 insufficient data' ELSE s.band END AS \"Band\"\nFROM companies c\nJOIN scores s ON s.company_id = c.id AND s.search_profile_id = $1::uuid AND s.profile_version = $2\nWHERE ($3 = '' OR c.run_id::text = $3)\nORDER BY s.fit_score DESC\nLIMIT (CASE WHEN $4 > 0 THEN $4 ELSE 200 END)",
    "options": {
     "queryReplacement": "={{ [ $('When Executed by Another Workflow').item.json.search_profile_id, $('When Executed by Another Workflow').item.json.profile_version || 1, $('When Executed by Another Workflow').item.json.run_id || '', $('When Executed by Another Workflow').item.json.publish_limit || 200 ] }}"
    }
   },
   "credentials": {
