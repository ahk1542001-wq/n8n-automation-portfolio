    ],
    "parameters": {
     "mode": "runOnceForAllItems",
     "jsCode": "const trig = $('When Executed by Another Workflow').first().json;\nconst prof = $input.first().json || {};\nconst out = { proceed: false, stop_reason: '',\n  profile_id: trig.profile_id || '', profile_version: trig.profile_version || 1,\n  run_id: trig.run_id || '' };\nif (!prof || !prof.business_context) { out.stop_reason = 'profile_not_found'; return [{ json: out }]; }\nif (prof.status !== 'approved') { out.stop_reason = 'profile_not_approved'; return [{ json: out }]; }\nout.proceed = true;\nreturn [{ json: out }];"
    }
