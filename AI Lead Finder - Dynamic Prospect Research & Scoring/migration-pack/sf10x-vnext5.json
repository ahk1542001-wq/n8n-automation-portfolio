  {
   "id": "61a929e8-2b39-4287-a15c-a28d700e60e6",
   "name": "Collect Control Rows",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    640,
    160
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const rows = $('Sheet - Read Control').all().map(i => i.json);\nconst map = { sent: 'owner_contacted', discarded: 'discarded', do_not_contact: 'do_not_contact' };\nconst list = [];\nfor (const r of rows) {\n  const a = String(r.Action || '').trim().toLowerCase();\n  if (r.company_id && map[a]) list.push({ company_id: String(r.company_id), person_key: '', reason: map[a] });\n}\nreturn [{ json: { payload: JSON.stringify(list), count: list.length } }];"
   }
  },
  {
   "id": "07a13add-794b-4686-870c-256ed3e250ce",
   "name": "DB - Upsert Suppression",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.6,
   "position": [
    880,
    160
   ],
   "parameters": {
    "operation": "executeQuery",
    "query": "INSERT INTO outreach_suppression (company_id, person_key, reason, created_by)\nSELECT (r->>'company_id')::uuid, NULLIF(r->>'person_key',''), r->>'reason', $2\nFROM jsonb_array_elements($1::jsonb) r\nON CONFLICT (company_id, person_key, reason) DO NOTHING\nRETURNING company_id",
    "options": {
     "queryReplacement": "={{ [ $json.payload, 'sheet:Outreach Control' ] }}"
    }
   },
   "credentials": {
    "postgres": {
     "id": "MpjjNGB3euuSq58i",
     "name": "Postgres account"
    }
   }
  },
  {
   "id": "4add6786-44c4-4fcb-b801-23837753facd",
   "name": "DB - Load Exportable",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.6,
   "position": [
    1120,
    160
   ],
   "parameters": {
    "operation": "executeQuery",
    "query": "SELECT d.id AS draft_id, d.company_id, d.export_key, d.channel, d.step, d.subject, d.body,\n       d.evidence_quote, d.evidence_observed_at, d.language, d.signoff_by,\n       c.name AS company_name, COALESCE(p.full_name, '') AS person_name,\n       EXISTS (SELECT 1 FROM outreach_suppression sx\n               WHERE sx.company_id = d.company_id\n                 AND (sx.person_key IS NULL OR sx.person_key = d.person_key)) AS suppressed_now,\n       (SELECT a.decision = 'approved' AND a.decided_at >= now() - interval '14 days'\n        FROM approvals a WHERE a.company_id = d.company_id\n        ORDER BY a.decided_at DESC LIMIT 1) AS approval_fresh,\n       (d.evidence_observed_at >= now() - interval '30 days') AS evidence_fresh,\n       (d.evidence_observed_at < now() - interval '7 days' AND\n        d.body ~* '(recently|just opened|newly|\u1019\u1000\u103c\u102c\u101e\u1031\u1038\u1001\u1004\u103a|\u101c\u1010\u103a\u1010\u101c\u1031\u102c|\u1001\u102f\u1010\u101c\u1031\u102c|\u1019\u1000\u103c\u102c\u101e\u1031\u1038\u1019\u102e)') AS recency_stale,\n       (d.language <> 'my' OR d.signoff_by IS NOT NULL OR\n        (SELECT count(*) FROM outreach_drafts dx\n         WHERE dx.profile_id = d.profile_id AND dx.language = 'my' AND dx.status = 'exported') >= 10) AS signoff_ok\nFROM outreach_drafts d\nJOIN companies c ON c.id = d.company_id\nLEFT JOIN people p ON p.id = d.person_id\nWHERE d.profile_id = $1 AND d.status = 'audited' AND d.audit_result = 'pass'\nORDER BY d.created_at",
    "options": {
     "queryReplacement": "={{ [ $('When Executed by Another Workflow').first().json.profile_id ] }}"
    }
   },
   "credentials": {
    "postgres": {
     "id": "MpjjNGB3euuSq58i",
     "name": "Postgres account"
    }
   }
  },
  {
   "id": "a60d4990-a7a5-4069-8fb6-e29ae0f56fab",
   "name": "Export Split",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1360,
    160
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const rows = $input.all().map(i => i.json);\nconst expired = [], clean = [];\nlet suppressed = 0, heldSignoff = 0;\nconst cleanRows = [];\nfor (const r of rows) {\n  if (r.suppressed_now) { suppressed++; continue; }\n  if (!r.approval_fresh || !r.evidence_fresh || r.recency_stale) { expired.push(r.draft_id); continue; }\n  if (!r.signoff_ok) { heldSignoff++; continue; }\n  cleanRows.push(r);\n}\nfor (const r of cleanRows) {\n  const evDate = new Date(r.evidence_observed_at);\n  const expiry = new Date(evDate.getTime() + 30 * 86400000);\n  clean.push({ ...r, has_clean: true,\n    evidence_date: evDate.toISOString().slice(0, 10),\n    expiry_date: expiry.toISOString().slice(0, 10),\n    expired_ids_json: JSON.stringify(expired) });\n}\nconst stats = { exportable_seen: rows.length, suppressed_blocked: suppressed,\n  held_signoff: heldSignoff, expired_marked: expired.length, clean: clean.length };\nif (!clean.length) return [{ json: { has_clean: false, expired_ids_json: JSON.stringify(expired), stats } }];\nfor (const c of clean) c.stats = stats;\nreturn clean.map(c => ({ json: c }));"
   },
   "alwaysOutputData": true
  },
