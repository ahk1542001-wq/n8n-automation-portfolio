  {
   "id": "42034a64-d0ed-418f-b1d4-de052aff6e4a",
   "name": "DB - Ranked Leads",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.6,
   "position": [
    320,
    400
   ],
   "parameters": {
    "operation": "executeQuery",
    "query": "SELECT $3::text AS run_id, c.id::text AS company_id, c.run_id::text || '|' || c.id::text AS lead_key, c.name AS \"Company\", c.category AS \"Category\", c.location AS \"Location\",\n       c.website AS \"Website\", CASE WHEN c.phone IS NULL OR c.phone = '' THEN '' ELSE '''' || c.phone END AS \"Phone\", c.facebook_url AS \"Facebook\", c.email AS \"Email\", c.company_size AS \"Size\",\n       c.rating AS \"Rating\", c.review_count AS \"Reviews\", COALESCE(c.raw_payload->>'social_url', '') AS \"Social\", (SELECT CASE WHEN ra.value->>'confidence_level' = 'high' THEN ra.value->>'value' WHEN ra.value->>'value' IS NOT NULL THEN (ra.value->>'value') || ' (low)' ELSE '' END FROM research_artifacts ra WHERE ra.company_id = c.id AND ra.field_name = 'company_size' ORDER BY ra.created_at DESC LIMIT 1) AS \"SizeBand\",\n       s.fit_score AS \"Fit\", s.timing_score AS \"Timing\",\n       CASE WHEN s.band = 'insufficient_data' THEN 'Unknown \u2014 insufficient data' ELSE s.band END AS \"Band\"\nFROM companies c\nJOIN scores s ON s.company_id = c.id AND s.search_profile_id = $1::uuid AND s.profile_version = $2\nWHERE ($3 = '' OR c.run_id::text = $3)\nORDER BY CASE\n           WHEN COALESCE(c.raw_payload->>'city', '') ILIKE '%yangon%' OR c.location ILIKE '%yangon%' THEN 0\n           WHEN COALESCE(c.raw_payload->>'city', '') ILIKE '%mandalay%' OR c.location ILIKE '%mandalay%' THEN 1\n           WHEN COALESCE(c.raw_payload->>'city', '') ILIKE '%bangkok%' OR c.location ILIKE '%bangkok%' OR COALESCE(c.raw_payload->>'state', '') ILIKE '%bangkok%' THEN 2\n           ELSE 3\n         END,\n         s.fit_score DESC\nLIMIT (CASE WHEN $4 > 0 THEN $4 ELSE 200 END)",
    "options": {
     "queryReplacement": "={{ [ $('When Executed by Another Workflow').item.json.search_profile_id, $('When Executed by Another Workflow').item.json.profile_version || 1, $('When Executed by Another Workflow').item.json.run_id || '', $('When Executed by Another Workflow').item.json.publish_limit || 200 ] }}"
    }
   },
   "credentials": {
    "postgres": {
     "id": "MpjjNGB3euuSq58i",
     "name": "Postgres account"
    }
   }
  },
