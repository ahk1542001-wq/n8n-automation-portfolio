 "nodes": [
  {
   "id": "1919d44b-a02d-4da4-bd25-d78e755ac3b6",
   "name": "Sticky Note afeeffda",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    100,
    592
   ],
   "parameters": {
    "content": "SF8 v-next.10 - Approval View Sync (F32 + SF6 contacts + People tab + lead_key + WHOLE-SHEET SORT + People Source/Evidence). Publishes ranked scored leads into the v-next Sheet COPY keyed by a single composite lead_key (run_id|company_id). After the People publish, a sort step re-reads ALL Lead Review rows, sorts them by city rank (Yangon -> Mandalay -> Bangkok -> other, rank from the Places record in Postgres) then Fit desc, writes city_rank + fit_num helper values (columns S and T) onto every row by lead_key, then issues ONE Sheets API sortRange call that reorders the whole Lead Review block atomically by city_rank asc then fit_num desc - so the main sheet itself stays sorted, not just each batch, with no clear/rewrite window. Decision and Note are carried from the sheet read itself (never sourced from the DB) and travel with their row. Phone values are apostrophe-prefixed on rewrite so they land as text, not formulas. Header gate: run_id, company_id, Decision, Note, lead_key must exist on the copy or zero rows are written and a Gmail draft names the missing header. insufficient_data rows show as Unknown - insufficient data (F31).",
    "color": 5
   }
  },
  {
   "id": "a5f82af8-8f77-4c7b-bd8c-79c2195376b1",
   "name": "When Executed by Another Workflow",
   "type": "n8n-nodes-base.executeWorkflowTrigger",
   "typeVersion": 1.1,
   "position": [
