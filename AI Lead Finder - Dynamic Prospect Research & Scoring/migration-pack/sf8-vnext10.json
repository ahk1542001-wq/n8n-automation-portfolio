   "parameters": {
    "operation": "executeQuery",
    "query": "SELECT c.id::text AS company_id, c.name AS \"Company\", p.full_name AS \"Person\", p.title AS \"Position\",\n       c.id::text || '|' || p.full_name AS person_key, p.linkedin_url AS \"LinkedIn\", CASE WHEN p.phone IS NULL OR p.phone = '' THEN '' ELSE '''' || p.phone END AS \"Phone\", p.email AS \"Email\", p.source AS \"Source\", p.evidence_quote AS \"Evidence\"\nFROM people p\nJOIN companies c ON c.id = p.company_id\nJOIN scores s ON s.company_id = c.id AND s.search_profile_id = $1::uuid AND s.profile_version = $2\nWHERE ($3 = '' OR c.run_id::text = $3)\nORDER BY s.fit_score DESC\nLIMIT (CASE WHEN $4 > 0 THEN $4 ELSE 200 END)",
